# Conexão com o PostgreSQL. Se a hospedagem não oferecer PostgreSQL nativo,
# use um provedor externo (ex.: Neon, Supabase, Railway) e cole a connection
# string aqui.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/agencia_viagem?schema=public"

# Porta em que a API vai escutar.
PORT=3333

# Segredo usado para assinar/verificar o JWT. Gere um valor aleatório forte
# (ex.: `openssl rand -hex 32`) — nunca reaproveite o exemplo abaixo em produção.
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"

# Tempo de expiração do token, no formato aceito pela lib `jsonwebtoken` (ex.: "12h", "7d").
JWT_EXPIRES_IN="12h"

# Origem(ns) autorizada(s) a chamar a API via CORS, separadas por vírgula.
# Como o frontend acessa a API através do proxy do Next.js (server-to-server),
# normalmente isso só precisa incluir a própria URL pública do frontend.
CORS_ORIGIN="http://localhost:3000"

# Diretório onde os anexos (documentos enviados) são armazenados em disco.
UPLOADS_DIR="uploads"

# Tamanho máximo de upload, em bytes (padrão: 15MB).
UPLOAD_MAX_BYTES=15728640

# URL pública sob a qual esta API é servida — usada para montar os links de
# download dos anexos e vouchers (ex.: https://api.seudominio.com).
PUBLIC_URL="http://localhost:3333"
