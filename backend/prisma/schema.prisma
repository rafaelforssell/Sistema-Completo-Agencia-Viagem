generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("admins")
}

model Cliente {
  id                  String    @id @default(uuid())
  nome                String
  email               String?
  telefone            String?
  telefoneDdi         String?
  dataNascimento      DateTime?
  numeroPassaporte    String?
  validadePassaporte  DateTime?
  rg                  String?
  cpf                 String?
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  estado              String?
  observacoes         String?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  viagens             Viagem[]
  anexos              Anexo[]
  contas              ContaFinanceira[]
  vendas              Venda[]
  leads               Lead[]
  interacoesCrm       InteracaoCrm[]
  tarefasCrm          TarefaCrm[]

  @@map("clientes")
}

enum StatusViagem {
  orcamento
  confirmada
  em_andamento
  concluida
  cancelada
}

model Viagem {
  id             String       @id @default(uuid())
  clienteId      String
  destino        String
  dataIda        DateTime
  dataVolta      DateTime
  companhiaAerea String?
  status         StatusViagem @default(orcamento)
  observacoes    String?
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  passageiros Passageiro[]
  pagamentos  Pagamento[]
  reembolsos  Reembolso[]
  comissoes   Comissao[]
  contas      ContaFinanceira[]
  anexos      Anexo[]
  vendas      Venda[]

  @@map("viagens")
}

model Passageiro {
  id                 String    @id @default(uuid())
  viagemId           String
  nome               String
  parentesco         String?
  email              String?
  telefone           String?
  dataNascimento     DateTime?
  numeroPassaporte   String?
  validadePassaporte DateTime?
  numeroBilhete      String?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  viagem Viagem  @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  anexos Anexo[]

  @@map("passageiros")
}

enum FormaPagamento {
  cartao_credito
  cartao_debito
  pix
  boleto
  transferencia
  dinheiro
}

enum TipoCartao {
  agencia
  cliente
  terceiro
}

model Pagamento {
  id                  String         @id @default(uuid())
  viagemId            String
  companhiaAerea      String?
  fornecedor          String
  formaPagamento      FormaPagamento
  tipoCartao          TipoCartao
  nomeTitularTerceiro String?
  valor               Decimal        @db.Decimal(12, 2)
  parcelas            Int            @default(1)
  dataPagamento       DateTime
  observacoes         String?
  criadoEm            DateTime       @default(now())
  atualizadoEm        DateTime       @updatedAt

  viagem     Viagem            @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  reembolsos Reembolso[]
  conta      ContaFinanceira?

  @@map("pagamentos")
}

enum StatusReembolso {
  solicitado
  em_analise
  aprovado
  pago
  negado
}

enum DestinoReembolso {
  cliente
  carteira_fornecedor
}

model Reembolso {
  id               String           @id @default(uuid())
  viagemId         String
  pagamentoId      String?
  fornecedorId     String?
  destino          DestinoReembolso @default(cliente)
  motivo           String
  valorSolicitado  Decimal          @db.Decimal(12, 2)
  valorAprovado    Decimal?         @db.Decimal(12, 2)
  status           StatusReembolso  @default(solicitado)
  dataSolicitacao  DateTime
  dataConclusao    DateTime?
  observacoes      String?
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt

  viagem     Viagem             @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  pagamento  Pagamento?         @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)
  fornecedor Fornecedor?        @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  carteiraMovimento CarteiraMovimento?

  @@map("reembolsos")
}

enum TipoCarteiraMovimento {
  credito
  debito
}

// Saldo de crédito que a agência tem com um fornecedor (operadora/consolidadora),
// geralmente originado de um reembolso que virou crédito em vez de voltar pro
// cliente. O saldo do fornecedor é sempre calculado (soma de créditos - débitos),
// nunca armazenado, pra nunca ficar dessincronizado.
model CarteiraMovimento {
  id           String                @id @default(uuid())
  fornecedorId String
  tipo         TipoCarteiraMovimento
  valor        Decimal               @db.Decimal(12, 2)
  descricao    String?
  data         DateTime
  reembolsoId  String?               @unique
  criadoEm     DateTime              @default(now())
  atualizadoEm DateTime              @updatedAt

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  reembolso  Reembolso? @relation(fields: [reembolsoId], references: [id], onDelete: Cascade)

  @@map("carteira_movimentos")
}

enum NaturezaConta {
  a_pagar
  a_receber
}

enum StatusConta {
  pendente
  pago
  atrasado
  cancelado
}

model ContaFinanceira {
  id         String        @id @default(uuid())
  natureza   NaturezaConta
  descricao  String
  origem     String
  origemNome String
  viagemId   String?
  clienteId  String?
  pagamentoId String?      @unique
  valor      Decimal       @db.Decimal(12, 2)
  vencimento DateTime
  status     StatusConta   @default(pendente)
  fonte      String?
  // false para entradas apenas informativas (ex.: pagamento já quitado
  // direto pelo cliente) — aparecem na listagem, mas não entram nos
  // somatórios de "a pagar"/"a receber" do resumo e do painel.
  contabilizavel Boolean   @default(true)
  criadoEm   DateTime      @default(now())
  atualizadoEm DateTime    @updatedAt

  viagem    Viagem?    @relation(fields: [viagemId], references: [id], onDelete: SetNull)
  cliente   Cliente?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  @@map("contas_financeiras")
}

enum StatusComissao {
  pendente
  recebida
  cancelada
}

model Comissao {
  id              String         @id @default(uuid())
  viagemId        String
  fornecedor      String
  percentual      Decimal        @db.Decimal(5, 2)
  valorBruto      Decimal        @db.Decimal(12, 2)
  valorLiquido    Decimal        @db.Decimal(12, 2)
  status          StatusComissao @default(pendente)
  dataPrevista    DateTime?
  dataRecebimento DateTime?
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  viagem Viagem @relation(fields: [viagemId], references: [id], onDelete: Cascade)

  @@map("comissoes")
}

enum TipoDocumento {
  passaporte
  rg
  cpf
  visto
  outro
}

model Anexo {
  id             String        @id @default(uuid())
  tipo           TipoDocumento
  nomeArquivo    String
  caminhoArquivo String
  mimeType       String
  tamanhoBytes   Int
  clienteId      String?
  viagemId       String?
  passageiroId   String?
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  cliente    Cliente?    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  viagem     Viagem?     @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  passageiro Passageiro? @relation(fields: [passageiroId], references: [id], onDelete: Cascade)

  @@map("anexos")
}

// Estado (lido/excluído) de alertas sintéticos (check-in, aniversário,
// passaporte), que são calculados em tempo real a partir de Cliente/Viagem —
// não persistidos como entidade própria. A chave é um id determinístico
// (ex.: "passaporte:<clienteId>").
model AlertaLido {
  chave      String    @id
  lido       Boolean   @default(false)
  lidoEm     DateTime?
  excluido   Boolean   @default(false)
  excluidoEm DateTime?

  @@map("alertas_lidos")
}

model Voucher {
  id       String   @id @default(uuid())
  viagemId String   @unique
  url      String
  geradoEm DateTime @default(now())

  @@map("vouchers")
}

enum TipoFornecedor {
  companhia_aerea
  hotel
  operadora
  seguradora
  transfer
  aluguel_carro
  passeios
  cruzeiro
  ingressos
  outro
}

model Fornecedor {
  id                String         @id @default(uuid())
  nome              String
  tipo              TipoFornecedor @default(outro)
  email             String?
  email2            String?
  telefone          String?
  telefone2         String?
  telefone3         String?
  site              String?
  cidade            String?
  pais              String?
  descricaoServicos String?
  observacoes       String?
  criadoEm          DateTime       @default(now())
  atualizadoEm      DateTime       @updatedAt

  contatos           FornecedorContato[]
  itensVenda         VendaItem[]
  reembolsos         Reembolso[]
  carteiraMovimentos CarteiraMovimento[]

  @@map("fornecedores")
}

model FornecedorContato {
  id           String  @id @default(uuid())
  fornecedorId String
  nome         String
  funcao       String?

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@map("fornecedor_contatos")
}

enum TipoVenda {
  viagem
  aereo
  hotel
  transfer
  seguro
  cruzeiro
  passeio
  aluguel_carro
  ingressos
  outro
}

enum StatusVenda {
  orcamento
  confirmada
  cancelada
}

model Venda {
  id            String      @id @default(uuid())
  clienteId     String
  viagemId      String?
  status        StatusVenda @default(orcamento)
  dataVenda     DateTime
  numeroPedido  String      @unique
  observacoes   String?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  cliente             Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  viagem              Viagem?             @relation(fields: [viagemId], references: [id], onDelete: SetNull)
  numeroPedidoExtras  NumeroPedidoExtra[]
  itens               VendaItem[]

  @@map("vendas")
}

// Cada item de uma venda tem seu próprio fornecedor — resolve o caso do
// "sub-fornecedor" (ex.: pacote fechado com a operadora, mas o hotel dentro
// do pacote é fornecido por outra empresa específica).
model VendaItem {
  id             String    @id @default(uuid())
  vendaId        String
  tipo           TipoVenda
  fornecedorId   String?
  descricao      String?
  valor          Decimal   @db.Decimal(12, 2)
  dataAluguel    DateTime?
  seguroCompleto Boolean?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  venda      Venda       @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  @@map("vendas_itens")
}

model NumeroPedidoExtra {
  id        String  @id @default(uuid())
  vendaId   String
  numero    String
  descricao String?

  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@map("numeros_pedido_extra")
}

enum EtapaLead {
  novo
  contato
  proposta
  fechado
  perdido
}

model Lead {
  id             String    @id @default(uuid())
  nome           String
  email          String?
  telefone       String?
  origem         String?
  etapa          EtapaLead @default(novo)
  clienteId      String?
  valorEstimado  Decimal?  @db.Decimal(12, 2)
  observacoes    String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  cliente    Cliente?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  interacoes InteracaoCrm[]
  tarefas    TarefaCrm[]

  @@map("crm_leads")
}

enum TipoInteracaoCrm {
  ligacao
  email
  whatsapp
  reuniao
  nota
}

model InteracaoCrm {
  id           String           @id @default(uuid())
  leadId       String?
  clienteId    String?
  tipo         TipoInteracaoCrm
  descricao    String
  data         DateTime
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("crm_interacoes")
}

model TarefaCrm {
  id             String   @id @default(uuid())
  leadId         String?
  clienteId      String?
  titulo         String
  descricao      String?
  dataVencimento DateTime
  concluida      Boolean  @default(false)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("crm_tarefas")
}
